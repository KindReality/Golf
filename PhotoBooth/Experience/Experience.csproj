<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <Compile Include="..\Shared\Telemetry.cs" Link="Diagnostics\Telemetry.cs" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon Condition="Exists('Media\icon.ico')">Media\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Shaders\BlackKey.ps" />
    <None Update="Media\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
