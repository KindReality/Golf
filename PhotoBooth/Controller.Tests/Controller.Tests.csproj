<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Controller\Controller.csproj" AdditionalProperties="CopyBuildOutputToOneDrive=false" />
    <None Include="..\Controller\appsettings.json" Link="appsettings.defaults.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Controller\appsettings.Development.json" Link="appsettings.environment.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
