<Window
    x:Class="SaftApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:SaftApp"
    mc:Ignorable="d"
    WindowStyle="None"
    ResizeMode="NoResize"
    WindowState="Normal"
    Background="{StaticResource ThemeBackground}"
    Foreground="{StaticResource ThemeText}"
    FontFamily="Segoe UI"
    ShowInTaskbar="True"
    Topmost="False"
    Title="Photobooth Companion"
    Loaded="Window_Loaded">

    <Window.Resources>

        <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
        <CubicEase x:Key="EaseIn"  EasingMode="EaseIn"/>

        <Storyboard x:Key="CountdownNumberInOut">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="countdownScale"
                                           Storyboard.TargetProperty="ScaleX"
                                           Duration="0:0:1">
                <EasingDoubleKeyFrame KeyTime="0%"   Value="0.6" EasingFunction="{StaticResource EaseOut}"/>
                <EasingDoubleKeyFrame KeyTime="35%"  Value="1.0" EasingFunction="{StaticResource EaseOut}"/>
                <EasingDoubleKeyFrame KeyTime="65%"  Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="100%" Value="1.0" EasingFunction="{StaticResource EaseIn}"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="countdownScale"
                                           Storyboard.TargetProperty="ScaleY"
                                           Duration="0:0:1">
                <EasingDoubleKeyFrame KeyTime="0%"   Value="0.6" EasingFunction="{StaticResource EaseOut}"/>
                <EasingDoubleKeyFrame KeyTime="35%"  Value="1.0" EasingFunction="{StaticResource EaseOut}"/>
                <EasingDoubleKeyFrame KeyTime="65%"  Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="100%" Value="1.0" EasingFunction="{StaticResource EaseIn}"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="countdownTranslate"
                                           Storyboard.TargetProperty="Y"
                                           Duration="0:0:1">
                <EasingDoubleKeyFrame KeyTime="0%"   Value="-400" EasingFunction="{StaticResource EaseOut}"/>
                <EasingDoubleKeyFrame KeyTime="35%"  Value="0"    EasingFunction="{StaticResource EaseOut}"/>
                <EasingDoubleKeyFrame KeyTime="65%"  Value="0"/>
                <EasingDoubleKeyFrame KeyTime="100%" Value="120"  EasingFunction="{StaticResource EaseIn}"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="tbCountdown"
                                           Storyboard.TargetProperty="Opacity"
                                           Duration="0:0:1">
                <DiscreteDoubleKeyFrame KeyTime="0%"   Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="5%"   Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="65%"  Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="100%" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="TransitionIn">
            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility"
                                           Duration="0:0:1">
                <DiscreteObjectKeyFrame KeyTime="0%" Value="{x:Static Visibility.Visible}"/>
            </ObjectAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:1"
                             FillBehavior="Stop">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="TransitionOut">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0"
                             Duration="0:0:1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility"
                                           Duration="0:0:1">
                <DiscreteObjectKeyFrame KeyTime="100%" Value="{x:Static Visibility.Collapsed}"/>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>

    </Window.Resources>

    <Grid SnapsToDevicePixels="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="overlayGrid" Grid.RowSpan="2" Width="244" Background="{StaticResource ThemeSurface}"
                BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,0,1,0" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="108"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
                <StackPanel Margin="22,20,22,0">
                    <TextBlock Text="HOME TECHNOLOGIES" Foreground="{StaticResource ThemeMuted}" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock Text="Camera" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,12"/>
                    <Border Background="{StaticResource ThemeAccent}" Height="2" Width="42" HorizontalAlignment="Left" Opacity="0.7"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,4,14,8">
                    <StackPanel>
                        <TextBlock Text="CAPTURE" Style="{StaticResource SectionCaption}"/>
                        <Button x:Name="btnCapture" Height="48" Style="{StaticResource PrimaryButtonStyle}" Click="BtnCapture_Click" AutomationProperties.Name="Capture photo">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE722;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Capture photo" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnPreview" Height="96" Margin="0,8,0,24" Style="{StaticResource DarkButtonStyle}" Click="BtnPreview_Click"
                                ToolTip="View the most recent photo" AutomationProperties.Name="Preview last photo">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource ThemeBackground}" CornerRadius="4" Margin="0,0,10,0">
                                    <Image x:Name="imgPreviewButton" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Last capture" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="View photo" FontSize="10" Foreground="{StaticResource ThemeMuted}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <TextBlock Text="EXPERIENCE TRIGGERS" Style="{StaticResource SectionCaption}"/>
                        <StackPanel x:Name="devTriggerPanel">
                            <Button x:Name="btnTrigger1" Style="{StaticResource DevButtonStyle}" Click="BtnTrigger1_Click" AutomationProperties.Name="Trigger 1, local video">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="01" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource ThemeAccent}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Trigger 1" FontWeight="SemiBold"/><TextBlock Text="Local video" FontSize="10" Foreground="{StaticResource ThemeMuted}"/></StackPanel>
                                </Grid>
                            </Button>
                            <Button x:Name="btnTrigger2" Style="{StaticResource DevButtonStyle}" Click="BtnTrigger2_Click" AutomationProperties.Name="Trigger 2, photo countdown">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="02" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource ThemeAccent}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Trigger 2" FontWeight="SemiBold"/><TextBlock Text="Photo countdown" FontSize="10" Foreground="{StaticResource ThemeMuted}"/></StackPanel>
                                </Grid>
                            </Button>
                            <Button x:Name="btnTrigger3" ToolTip="Play ping.mp4 on Display One" Style="{StaticResource DevButtonStyle}" Click="BtnTrigger3_Click" AutomationProperties.Name="Trigger 3, Display One">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="03" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource ThemeAccent}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Trigger 3" FontWeight="SemiBold"/><TextBlock Text="Display One" FontSize="10" Foreground="{StaticResource ThemeMuted}"/></StackPanel>
                                </Grid>
                            </Button>
                            <Button x:Name="btnTrigger4" ToolTip="Play ping.mp4 on Projector" Style="{StaticResource DevButtonStyle}" Click="BtnTrigger4_Click" AutomationProperties.Name="Trigger 4, Projector">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="04" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource ThemeAccent}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Trigger 4" FontWeight="SemiBold"/><TextBlock Text="Projector" FontSize="10" Foreground="{StaticResource ThemeMuted}"/></StackPanel>
                                </Grid>
                            </Button>
                            <Button x:Name="btnTrigger5" ToolTip="Play ping.mp4 on Display Two" Style="{StaticResource DevButtonStyle}" Click="BtnTrigger5_Click" AutomationProperties.Name="Trigger 5, Display Two">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="05" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource ThemeAccent}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Trigger 5" FontWeight="SemiBold"/><TextBlock Text="Display Two" FontSize="10" Foreground="{StaticResource ThemeMuted}"/></StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="22,14">
                    <StackPanel>
                        <TextBlock Text="NETWORK TARGET" Foreground="{StaticResource ThemeMuted}" FontSize="9" FontWeight="SemiBold"/>
                        <TextBlock x:Name="devNetworkStatus" Text="Initializing network" Foreground="{StaticResource ThemeAccent}" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="developerHeader" Grid.Column="1" Margin="24,20,24,18" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Live preview" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="PHOTOBOOTH COMPANION / DEVELOPMENT" FontSize="10" Foreground="{StaticResource ThemeMuted}" Margin="0,5,0,0"/></StackPanel>
            <Border Grid.Column="1" Background="{StaticResource ThemeRaised}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="14" Padding="14,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource ThemeAccent}" Margin="0,0,8,0"/><TextBlock x:Name="devStateText" Text="IDLE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ThemeAccent}"/></StackPanel>
            </Border>
        </Grid>

        <Border x:Name="presentationBorder" Grid.Column="1" Grid.Row="1" Background="Black" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0" ClipToBounds="True">
            <Grid>
                <Grid x:Name="previewGrid">
                    <StackPanel x:Name="previewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE722;" FontSize="36" Foreground="#334B61" HorizontalAlignment="Center"/>
                        <TextBlock Text="Camera preview" FontSize="14" Foreground="{StaticResource ThemeMuted}" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Image x:Name="imgPreview" Stretch="Uniform" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <Canvas x:Name="FaceLayer" Background="Transparent" IsHitTestVisible="False"/>
                <Grid x:Name="videoGrid" Visibility="Collapsed">
                    <MediaElement x:Name="videoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" IsHitTestVisible="False" MediaEnded="VideoPlayer_MediaEnded"/>
                </Grid>
                <Grid x:Name="captureGrid" Visibility="Collapsed">
                    <Image x:Name="imgCapture" Stretch="Uniform" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <Grid x:Name="countdownGrid" Visibility="Collapsed">
                    <TextBlock x:Name="tbCountdown" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="350"
                               FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="{StaticResource ThemeAccent}" Opacity="0"
                               TextAlignment="Center" RenderTransformOrigin="0.5,0.5" CacheMode="BitmapCache">
                        <TextBlock.RenderTransform><TransformGroup><ScaleTransform x:Name="countdownScale" ScaleX="1" ScaleY="1"/><TranslateTransform x:Name="countdownTranslate" X="0" Y="0"/></TransformGroup></TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>
        <Grid x:Name="transitionGrid" Grid.ColumnSpan="2" Grid.RowSpan="2" Visibility="Collapsed">
            <Rectangle x:Name="rectTransition" Fill="White" Opacity="0" Visibility="Collapsed" CacheMode="BitmapCache"/>
        </Grid>
    </Grid>
</Window>
