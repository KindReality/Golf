<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>..\Shared\Appearance\Application.ico</ApplicationIcon>
    <ControllerEnvironment Condition="'$(Configuration)' == 'Release'">Production</ControllerEnvironment>
    <ControllerEnvironment Condition="'$(Configuration)' != 'Release'">Development</ControllerEnvironment>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/*.png" />
    <EmbeddedResource Include="..\Shared\Appearance\Application.ico" Link="Assets\Application.ico" LogicalName="Controller.Assets.Application.ico" />
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
    <Compile Include="..\Shared\Telemetry.cs" Link="Diagnostics\Telemetry.cs" />
    <Compile Include="..\Shared\MediaLibrary\*.cs" Link="Media\Shared\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Updates\*.cs" Link="Updates\%(Filename)%(Extension)" />
    <None Include="..\Shared\Networking\NetworkAccess.ps1" Link="NetworkAccess.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\Shared\Updates\Stage-ApplicationUpdate.ps1" Link="Stage-ApplicationUpdate.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="..\Shared\Configuration\*.cs" Link="Configuration\Shared\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Appearance\*.cs" Link="Appearance\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Networking\*.cs" Link="Networking\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Windows\*.cs" Link="Windows\Shared\%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="Controller.Tests" />
    <None Update="appsettings.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update="Install-Controller.cmd;Install-Controller.ps1;Restart-Controller.cmd;Restart-Controller.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="appsettings.Development.json;appsettings.Production.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <Target Name="ControllerConfigurationTransform" AfterTargets="CopyFilesToOutputDirectory">
    <Copy SourceFiles="appsettings.json" DestinationFiles="$(TargetDir)appsettings.defaults.json" />
    <Copy SourceFiles="appsettings.$(ControllerEnvironment).json" DestinationFiles="$(TargetDir)appsettings.environment.json" />
  </Target>
  <Target Name="ControllerPublishConfigurationTransform" AfterTargets="Publish">
    <Copy SourceFiles="appsettings.json" DestinationFiles="$(PublishDir)appsettings.defaults.json" />
    <Copy SourceFiles="appsettings.$(ControllerEnvironment).json" DestinationFiles="$(PublishDir)appsettings.environment.json" />
  </Target>
</Project>
